{
	"Name": "Screen Switcher",
	"Version": "1.1.0.0",
	"Author": "rrytter",
	"Description": "Applies Screen Switcher scenes (displays, primary display, audio, input sources) and shows the active scene.",
	"Category": "Screen Switcher",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Icon": "imgs/plugin/marketplace",
	"URL": "https://github.com/rrytter/screen-switcher",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"UUID": "com.rrytter.screenswitcher",
	"Actions": [
		{
			"Name": "Scene",
			"UUID": "com.rrytter.screenswitcher.scene",
			"Icon": "imgs/actions/scene/icon",
			"Tooltip": "Applies a Screen Switcher scene. Inactive scenes are dimmed.",
			"PropertyInspectorPath": "ui/scene.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "imgs/actions/scene/key",
					"ShowTitle": false
				}
			]
		}
	]
}